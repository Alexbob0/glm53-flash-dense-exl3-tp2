# [dense-overlay] image dérivée : E2 + exl3.py non_routed + fork quant_config.
# Build identique sur les DEUX nœuds (règle §3) ; vérif par CONTENU (§7).
FROM ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks:exl3
COPY overlay/exl3.py /usr/local/lib/python3.12/dist-packages/vllm/model_executor/layers/quantization/exl3.py
COPY overlay/glm5next-patched/model.py /usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/model.py
COPY overlay/glm5next-patched/kda.py /usr/local/lib/python3.12/dist-packages/vllm/models/glm5next/nvidia/kda.py
